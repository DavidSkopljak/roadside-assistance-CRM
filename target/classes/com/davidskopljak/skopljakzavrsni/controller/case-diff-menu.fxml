<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<MenuBar fx:id="menuBar" layoutY="0.0" prefHeight="30.0" prefWidth="1080.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidskopljak.skopljakzavrsni.controller.CaseDiffMenuController">
    <menus>
        <Menu id="saveChangesMenu" mnemonicParsing="false" text="Save changes">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleSaveChanges" text="Save" />
            </items>
        </Menu>
        <Menu id="filterCasesMenu" mnemonicParsing="false" text="Exit">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
            </items>
        </Menu>
    </menus>
</MenuBar>
