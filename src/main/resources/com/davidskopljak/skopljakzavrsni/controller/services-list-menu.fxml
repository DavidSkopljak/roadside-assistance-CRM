<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>

<MenuBar prefHeight="30.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidskopljak.skopljakzavrsni.controller.ServicesListMenuController">
    <menus>
        <Menu mnemonicParsing="false" text="New service">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleNewService" text="New" />
            </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Back to case">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleBackToCase" text="Back" />
            </items>
        </Menu>
    </menus>
</MenuBar>
